# Copiar a .env y completar. Nunca subir .env a git.

# --- Base de datos ---
# Local (XAMPP): 127.0.0.1 / 3306 / root / (vacío)
# Servidor (cPanel): localhost / 3306 / usuario y base con prefijo de la cuenta
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kairon_therapy

# --- Auth --- (JWT_SECRET: mínimo 32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=3000
# development en local, production en el servidor (activa cookie secure)
NODE_ENV=development
# Orígenes permitidos (coma-separados). Local: el dev server de Vite. Servidor: https://tu-dominio
CORS_ORIGINS=http://localhost:5173

# --- Correo (postulaciones) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RECRUITER_EMAIL=
